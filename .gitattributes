# Normalize text files in the repository and store them with LF line endings.
* text=auto eol=lf

# Keep Windows command scripts compatible with cmd.exe.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets must never be modified by Git's line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.bmp binary
*.svgz binary
*.pdf binary
*.zip binary
*.gz binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.wasm binary
*.onnx binary
*.bin binary
*.mp3 binary
*.mp4 binary
*.webm binary
